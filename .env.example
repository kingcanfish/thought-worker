# 密钥和运行环境（复制为 .env，不要提交）。站点信息在 site.env 里。
BOT_TOKEN=123456:ABC-your-bot-token
WEBHOOK_SECRET=random-long-string

# 数据库：sqlite（DATA_DIR/thought.db，自建服务器）/ d1（Cloudflare D1）
DB=sqlite
# D1_DATABASE_ID=              # DB=d1 时；账户和 token 用 CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# 媒体存储：fs（本地磁盘）/ r2 / s3
STORAGE=fs
DATA_DIR=./data               # thought.db 和 media/
# STORAGE=r2 时
# R2_ACCOUNT_ID=
# R2_BUCKET=thought-worker-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE=s3 时（MinIO / AWS S3 / Backblaze B2 …）
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# 可选：自建 Local Bot API Server 可突破 20MB 下载限制
# TELEGRAM_API_BASE=https://api.telegram.org
# MAX_DOWNLOAD_BYTES=20971520

# 自建服务器
PORT=8787
