# 密钥和运行环境（复制为 .env，不要提交）。站点信息在 site.env 里。
BOT_TOKEN=123456:ABC-your-bot-token
WEBHOOK_SECRET=random-long-string

# 存储：fs（本地磁盘，自建服务器）/ r2 / s3
# 媒体和数据（收件箱 + 数据库）分开存放：媒体可以公开，数据不能
STORAGE=fs
DATA_DIR=./data               # fs：DATA_DIR/media 和 DATA_DIR/private
# STORAGE=r2 时
# R2_ACCOUNT_ID=
# R2_BUCKET=thought-worker-media
# R2_DATA_BUCKET=thought-worker-data
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE=s3 时（MinIO / AWS S3 …）
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=
# S3_DATA_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# 可选：自建 Local Bot API Server 可突破 20MB 下载限制
# TELEGRAM_API_BASE=https://api.telegram.org
# MAX_DOWNLOAD_BYTES=20971520

# 自建服务器
PORT=8787
