# 自建服务器（Node）用：复制为 .env
BOT_TOKEN=123456:ABC-your-bot-token
WEBHOOK_SECRET=random-long-string
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=your_channel
SITE_TITLE=碎碎念
SITE_DESCRIPTION=一些不成文的想法、路上拍的照片，和偶尔的抱怨。同步自 Telegram。
SITE_AVATAR=念
SITE_TZ=Asia/Shanghai
MEDIA_BASE=/m
# 可选：自建 Local Bot API Server 时改成它的地址，可突破 20MB 下载限制
# TELEGRAM_API_BASE=https://api.telegram.org
# MAX_DOWNLOAD_BYTES=20971520
# Node 专用
PORT=8787
DATA_DIR=./data
