{
  "name": "thought-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:site": "tsx src/build/main.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:node": "tsx watch src/adapters/node/server.ts",
    "build:node": "esbuild src/adapters/node/server.ts src/build/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/node --outbase=src",
    "start:node": "node dist/node/adapters/node/server.js",
    "build:site:node": "node dist/node/build/main.js",
    "tg:webhook": "tsx scripts/set-webhook.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
